# Configuración HTTP inicial — TEMPLATE (no modificar directamente).
# Solo para obtener el certificado SSL con Certbot.
# deploy.sh genera nginx/http.conf a partir de este archivo.

server {
    listen 80;
    server_name tudominio.com www.tudominio.com;

    # Ruta de verificación de Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo lo demás: redirigir a HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}
