# ─────────────────────────────────────────────────────────────────────────────
# SpeedSkateTrack Hub — Variables de Producción (VPS + Traefik)
# Copia este archivo como .env.production y rellena los valores reales.
# NUNCA commitear .env.production al repositorio.
#
# Uso:
#   docker compose --env-file .env.production up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio ──────────────────────────────────────────────────────────────────
# Dominio principal de la app (sin https://)
# Traefik generará el certificado SSL automáticamente via leresolver
DOMAIN=skatetrack.tudominio.com

# ── Backend (FastAPI + Celery) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
OPENAI_API_KEY=sk-...                   # requerido para embeddings RAG (SPEC-025)
FRONTEND_URL=https://skatetrack.tudominio.com
ENVIRONMENT=production

# ── Redis ────────────────────────────────────────────────────────────────────
# Contraseña interna de Redis (solo accesible dentro de app_net)
REDIS_PASSWORD=genera_una_clave_segura_aqui
# REDIS_URL se construye automáticamente en docker-compose usando REDIS_PASSWORD

# ── Frontend (Vite build args — baked in at Docker build time) ───────────────
# Estas variables van al bundle JS — son públicas por diseño (anon key, no service key)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_BACKEND_URL se deja vacío intencionalmente:
# El frontend usa URLs relativas (/api/...) y nginx hace el proxy al backend interno.
# NO cambiar esto — si se pone una URL absoluta se rompe el proxy SSE.

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@tudominio.com   # debe estar verificado en resend.com

# ── Sentry (error tracking — opcional) ───────────────────────────────────────
SENTRY_DSN=https://xxx@oXXXXXX.ingest.sentry.io/XXXXXX

# ── Flower (monitor Celery) ───────────────────────────────────────────────────
# Accesible en: https://flower.skatetrack.tudominio.com/flower
FLOWER_USER=admin
FLOWER_PASSWORD=genera_una_clave_segura_aqui

# ── WhatsApp / Twilio (AUTO-36) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886         # número WhatsApp aprobado en E.164
