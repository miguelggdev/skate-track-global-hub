# ─── Variables de entorno para producción ───────────────────────────────────
# Copia este archivo como .env.production y rellena los valores reales.
# NUNCA subas .env.production al repositorio.

# ── Backend (FastAPI + Celery) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
OPENAI_API_KEY=                         # opcional, solo si usas el RAG con OpenAI
FRONTEND_URL=https://tudominio.com
ENVIRONMENT=production
REDIS_PASSWORD=cambia_esto_en_produccion  # contraseña para Redis, úsala también en REDIS_URL
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0  # incluye la contraseña; usa el servicio interno de Docker

# ── Frontend (Vite build — usadas por deploy.sh antes del build) ─────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_BACKEND_URL=https://tudominio.com  # sin /api al final, Nginx lo gestiona

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@tudominio.com   # debe estar verificado en resend.com

# ── Sentry (error tracking) ──────────────────────────────────────────────────
# Backend DSN (privado, solo backend)
SENTRY_DSN=https://xxx@oXXXXXX.ingest.sentry.io/XXXXXX

# ── Flower (Celery monitor — acceso restringido) ──────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=cambia_esto_fuerte_en_produccion

# ── WhatsApp / Twilio (AUTO-36) ───────────────────────────────────────────────
# console.twilio.com → Messaging → Senders → WhatsApp senders
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886         # número WhatsApp aprobado en E.164

# ── Dominio (usado por deploy.sh para sustituir en nginx/default.conf) ───────
DOMAIN=tudominio.com
CERTBOT_EMAIL=admin@tudominio.com   # email real para notificaciones de expiración Let's Encrypt
