# ─── Variables de entorno para producción ───────────────────────────────────
# Copia este archivo como .env.production y rellena los valores reales.
# NUNCA subas .env.production al repositorio.

# ── Backend (FastAPI + Celery) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
OPENAI_API_KEY=                         # opcional, solo si usas el RAG con OpenAI
FRONTEND_URL=https://tudominio.com
ENVIRONMENT=production
REDIS_URL=redis://redis:6379/0          # no cambiar, usa el servicio interno de Docker

# ── Frontend (Vite build — usadas por deploy.sh antes del build) ─────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_BACKEND_URL=https://tudominio.com  # sin /api al final, Nginx lo gestiona

# ── Dominio (usado por deploy.sh para sustituir en nginx/default.conf) ───────
DOMAIN=tudominio.com
CERTBOT_EMAIL=admin@tudominio.com   # email real para notificaciones de expiración Let's Encrypt
