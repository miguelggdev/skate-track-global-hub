# ============================================================
# Backend Python — Variables de Entorno
# Copia este archivo a .env y completa los valores reales
# NUNCA commitear el archivo .env al repositorio
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# URL del proyecto (ej: https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — tiene permisos full, usar solo en backend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — disponible en Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- OpenAI (para embeddings RAG - SPEC-025) ---
OPENAI_API_KEY=sk-...

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Entorno ---
# development | production
ENVIRONMENT=development

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@skateclubhub.com

# --- Celery + Redis (Sprint 3) ---
REDIS_URL=redis://localhost:6379/0

# --- Sentry (error tracking) ---
# Obtener en: sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=

# --- Flower (Celery monitor) ---
FLOWER_USER=admin
FLOWER_PASSWORD=cambia_esto_en_produccion

# --- Webhooks event-driven (AUTO-04, 07, 12, 14, 20, 24, 30) ---
# Secret compartido entre Supabase Database Webhooks y el backend.
# Genera con: openssl rand -hex 32
# Configura en Supabase Dashboard → Database → Webhooks → HTTP Header: X-Webhook-Secret
WEBHOOK_SECRET=cambia_esto_por_un_secreto_seguro

# --- WhatsApp / Twilio (AUTO-36) ---
# Obtener en: console.twilio.com → WhatsApp Sandbox (dev) o WhatsApp Business (prod)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de WhatsApp aprobado por Twilio (formato E.164, ej: +14155238886)
TWILIO_WHATSAPP_FROM=+14155238886
