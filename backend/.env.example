# ============================================================
# Backend Python — Variables de Entorno
# Copia este archivo a .env y completa los valores reales
# NUNCA commitear el archivo .env al repositorio
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# URL del proyecto (ej: https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — tiene permisos full, usar solo en backend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — disponible en Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- OpenAI (para embeddings RAG - SPEC-025) ---
OPENAI_API_KEY=sk-...

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Entorno ---
# development | production
ENVIRONMENT=development

# --- Celery + Redis (Sprint 3) ---
REDIS_URL=redis://localhost:6379/0
